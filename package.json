{
  "name": "Whot",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://k-whot.vercel.app",
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.1.1",
    "@testing-library/user-event": "^13.5.0",
    "canvas-confetti": "^1.5.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-flip-toolkit": "^7.0.13",
    "react-redux": "^8.0.1",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "redux": "^4.2.0",
    "socket.io-client": "^4.5.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently \"pnpm tailwind:dev\" \"react-scripts start\"",
    "build": "pnpm tailwind:build && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prestart": "pnpm tailwind:generate",
    "pretest": "pnpm tailwind:generate",
    "tailwind:generate": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.output.css",
    "tailwind:dev": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.output.css --watch",
    "tailwind:build": "tailwindcss -i ./src/tailwind.css -o ./src/tailwind.output.css --minify",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start:server": "nodemon --watch server --exec ts-node --project server/tsconfig.json server/index.ts",
    "dev": "concurrently \"pnpm start\" \"pnpm run start:server\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.17",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/socket.io": "^3.0.2",
    "concurrently": "^9.2.1",
    "gh-pages": "^3.2.3",
    "nodemon": "^3.1.11",
    "socket.io": "^4.8.1",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
